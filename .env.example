# Copy to .env and adjust. Values are the compose defaults.
# scripts/start.sh (Linux/macOS) and scripts/start.ps1 (Windows) set these
# automatically; the values below are for manual `docker compose` calls.

# --- PyTorch backend (profile: torch) ---
QEV_MODEL=OmniJev/OneJev-4B
QEV_PORT=8000
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
QEV_DEBIAS=1

# --- PyTorch ROCm backend (profile: rocm) ---
TORCH_ROCM_INDEX_URL=https://download.pytorch.org/whl/rocm6.3
# GPU passthrough: match your host with `getent group video render`.
AMD_VIDEO_GID=44
AMD_RENDER_GID=109
# Only needed when the ROCm build does not know your gfx arch, e.g. gfx1100 on RDNA3.
# Leave it commented out otherwise: an empty value makes ROCr hide every GPU.
# HSA_OVERRIDE_GFX_VERSION=11.0.0
# To pin specific GPUs, add `HIP_VISIBLE_DEVICES=0,1` to the qev-rocm service in
# docker-compose.yml. Do not set it empty: an empty value hides every GPU.

# --- GGUF backends (profiles: gguf, gguf-rocm, vulkan, cpu) ---
# Directory holding your *.gguf and *mmproj*.gguf files (bind-mounted read-only).
LLAMA_MODELS_DIR=./models
LLAMA_MODEL=/models/model.gguf
LLAMA_MMPROJ=/models/mmproj.gguf
LLAMA_N_GPU_LAYERS=99
LLAMA_CTX=65536
LLAMA_PARALLEL=2
QEV_GGUF_NAME=OneJev-4B
QEV_GGUF_PORT=8001
# Render-node GID for /dev/dri (vulkan profile); match your host with `getent group render`.
DRI_RENDER_GID=109

# --- Playground (nginx) ---
# Upstream for /v1 and /health. Set it to match the profile you start:
#   torch -> qev:8000 | rocm -> qev-rocm:8000 | gguf/gguf-rocm/vulkan/cpu -> qev-gguf:8000
QEV_UPSTREAM=qev:8000
PLAYGROUND_PORT=8080

# --- Hugging Face ---
# Token for gated/private repos; mount a shared cache through the hf-cache volume.
HF_TOKEN=
